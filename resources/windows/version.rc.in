#include <winver.h>

1 VERSIONINFO
FILEVERSION @MOD_VERSION_MAJOR@,@MOD_VERSION_MINOR@,@MOD_VERSION_PATCH@,0
PRODUCTVERSION @MOD_VERSION_MAJOR@,@MOD_VERSION_MINOR@,@MOD_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Pragtical Team"
            VALUE "FileDescription", "Pragtical"
            VALUE "FileVersion", "@PROJECT_ASSEMBLY_VERSION@"
            VALUE "InternalName", "pragtical"
            VALUE "OriginalFilename", "pragtical.exe"
            VALUE "ProductName", "Pragtical"
            VALUE "ProductVersion", "@PROJECT_ASSEMBLY_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
